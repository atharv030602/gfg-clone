{
  "name": "gfg-clone",
  "version": "2.0.0",
  "description": "GeeksforGeeks Clone - Dynamic Learning Platform with Firebase & Gemini AI",
  "scripts": {
    "dev": "concurrently \"npm run serve\" \"npm run backend\"",
